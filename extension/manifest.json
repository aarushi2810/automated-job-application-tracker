{
  "manifest_version": 3,
  "name": "Job Application Auto Tracker",
  "version": "1.2",
  "description": "Automatically (and manually) save job applications from major job portals to your tracker backend.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://automated-job-application-tracker.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Job Application Tracker",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.workday.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://*.glassdoor.co.in/*",
        "*://*.wellfound.com/*",
        "*://*.angel.co/*",
        "*://*.icims.com/*",
        "*://*.taleo.net/*",
        "*://*.jobvite.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.bamboohr.com/*",
        "*://*.recruitee.com/*",
        "*://*.breezy.hr/*",
        "*://*.applytojob.com/*",
        "*://*.dice.com/*",
        "*://*.ziprecruiter.com/*",
        "*://*.monster.com/*",
        "*://*.naukri.com/*",
        "*://*.careers-page.com/*",
        "*://*.ultipro.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.workday.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://*.glassdoor.co.in/*",
        "*://*.wellfound.com/*",
        "*://*.angel.co/*",
        "*://*.icims.com/*",
        "*://*.taleo.net/*",
        "*://*.jobvite.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.bamboohr.com/*",
        "*://*.recruitee.com/*",
        "*://*.breezy.hr/*",
        "*://*.applytojob.com/*",
        "*://*.dice.com/*",
        "*://*.ziprecruiter.com/*",
        "*://*.monster.com/*",
        "*://*.naukri.com/*",
        "*://*.careers-page.com/*",
        "*://*.ultipro.com/*"
      ],
      "js": ["network_intercept.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
